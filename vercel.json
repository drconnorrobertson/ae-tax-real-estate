{
  "redirects": [
    {
      "source": "/blog/1031-exchange-rules-for-investors",
      "destination": "https://www.aetaxadvisors.com/blog/1031-exchange-timeline-45-180-day-rules/",
      "permanent": true
    },
    {
      "source": "/blog/str-tax-strategies-short-term-rental",
      "destination": "https://www.aetaxadvisors.com/blog/short-term-rental-tax-strategy-guide/",
      "permanent": true
    }
  ],
  "buildCommand": "node topical-depth-build.cjs && node brand-build.cjs && node scripts/brand-check.mjs public",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
